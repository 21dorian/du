# Base URL of the existing WordPress install (content source via REST API)
WP_API_URL=https://dukanette.fr

# Giscus (GitHub Discussions-based comments) - create at https://giscus.app
NEXT_PUBLIC_GISCUS_REPO=owner/repo
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=Comments
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# Newsletter provider endpoint (e.g. Buttondown, Mailchimp) - wired up later
NEWSLETTER_API_KEY=
